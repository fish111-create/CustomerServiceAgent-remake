# 文件功能：记录项目本地配置、缓存和运行产物的忽略规则。
# IDE and operating-system files
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Python environments and caches
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local-only tests and scratch files for this project
tests/
tmp/
temp/
*.tmp

# Secrets and local configuration
.env
.env.*
!.env.example

# Runtime data generated by the service
uploads/
**/uploads/
chroma_db/
**/chroma_db/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log
logs/

# Frontend tooling output, if introduced later
node_modules/
dist/
build/
.cache/
docs/known_issues.md